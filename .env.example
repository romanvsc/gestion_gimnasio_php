# Copiar este archivo como backend/.env y completar los valores del entorno
# NUNCA subir backend/.env al repositorio ni reemplazar el .env de Ferozo con datos locales

# Base de datos local
DB_HOST=localhost
DB_NAME=c2650268_gym
DB_USER=root
DB_PASS=

# JWT - Cambiar por una cadena aleatoria larga y segura
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_aleatoria_minimo_32_chars
