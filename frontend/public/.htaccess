Options -Indexes

RewriteEngine On
RewriteBase /gimnasio/

# No reescribir API ni assets estaticos
RewriteRule ^api/ - [L]
RewriteRule ^assets/ - [L]
RewriteRule ^favicon\.ico$ - [L]

# Si el archivo/carpeta existe, servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA: redirigir rutas cliente a index.html
RewriteRule . index.html [QSA,L]

# Headers de caché para assets con hash
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# index.html sin caché
<FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
</FilesMatch>

# Comprimir
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
